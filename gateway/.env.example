# ── Non-sensitive config (set directly) ─────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

NATS_URL=nats://localhost:4222
ORCHESTRATOR_GRPC_URL=localhost:50051

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

OIDC_ISSUER=https://your-auth-provider.com
OIDC_AUDIENCE=your-client-id

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=gateway

# ── Vault (secrets are fetched from here at startup) ─────────────────────────
# Local dev (docker-compose): token auth
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_SECRET_PATH=secret/data/gateway

# Production (k8s): Kubernetes auth — set VAULT_ROLE instead of VAULT_TOKEN
# VAULT_ADDR=http://vault.vault-system.svc.cluster.local:8200
# VAULT_ROLE=gateway
# (VAULT_TOKEN must NOT be set when using VAULT_ROLE)
