# gRPC Server Configuration
GRPC_PORT=50051

# Kubernetes Configuration
KUBECONFIG=~/.kube/config

# vCluster Configuration
VCLUSTER_NAMESPACE=vcluster-system
VCLUSTER_CHART_REPO=https://charts.loft.sh
VCLUSTER_CHART_VERSION=0.19.0

# Sandbox Configuration
SANDBOX_TTL=2h
MAX_SANDBOXES_PER_USER=5

# NATS Configuration
NATS_URL=nats://localhost:4222

# OpenTelemetry Configuration
OTEL_ENDPOINT=localhost:4317

# Network Configuration
TESTER_POD_CIDR=10.244.0.0/16

# Health Check Configuration
HEALTH_CHECK_INTERVAL=2s
HEALTH_CHECK_TIMEOUT=90s

# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=lab-provisioning
